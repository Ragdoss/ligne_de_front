{
  "name": "ligne-de-front",
  "version": "0.1.0",
  "description": "Ligne de Front — jeu de cartes de régiments",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && vitest run",
    "sim": "tsx tools/simulate.ts",
    "decks": "tsx tools/random-decks.ts",
    "ranking": "tsx tools/card-ranking.ts",
    "integrate": "tsx tools/integrate-patch.ts",
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web",
    "build:artifact": "vite build && node tools/to-artifact.mjs",
    "difficulty": "tsx tools/campaign-difficulty.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.4"
  },
  "private": true,
  "type": "module",
  "dependencies": {
    "peerjs": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  }
}
